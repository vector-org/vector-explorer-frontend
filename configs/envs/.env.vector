# Local ENVs
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws

# Instance ENVs
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_HOST=explorer.evm.wasm.host
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml
NEXT_PUBLIC_COLOR_THEME_DEFAULT=dark
NEXT_PUBLIC_HAS_BEACON_CHAIN=true
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_NAVIGATION_LAYOUT=vertical
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Vector
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=VCTR
NEXT_PUBLIC_NETWORK_ID=1
NEXT_PUBLIC_NETWORK_LOGO=https://playonvector.com/logo.svg
NEXT_PUBLIC_NETWORK_ICON=https://playonvector.com/logo-icon.svg
NEXT_PUBLIC_NETWORK_NAME=Vector
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc.evm.wasm.host/
NEXT_PUBLIC_NETWORK_SHORT_NAME=Vector
NEXT_PUBLIC_OG_ENHANCED_DATA_ENABLED=false
NEXT_PUBLIC_OTHER_LINKS=[]
NEXT_PUBLIC_VISUALIZE_API_HOST=https://visualizer.evm.wasm.host
NEXT_PUBLIC_STATS_API_HOST=https://stats.evm.wasm.host
FAVICON_MASTER_URL=https://playonvector.com/logo-icon.svg
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
